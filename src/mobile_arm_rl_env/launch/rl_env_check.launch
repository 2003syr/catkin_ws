<launch>
    <param name="/use_sim_time" value="true" />

    <!-- world -> base_link is published only by the URDF world_fixed joint. -->
    <node pkg="tf"
          type="static_transform_publisher"
          name="target_tf_pub"
          args="1.5 0.0 0.8 0 0 0 world target_frame 100" />

    <node pkg="mobile_arm_rl_env"
          type="mobile_arm_env_check.py"
          name="mobile_arm_env_check"
          output="screen">
        <param name="base_frame" value="base_link" />
        <param name="ee_frame" value="link6" />
        <param name="target_frame" value="target_frame" />
    </node>
</launch>
