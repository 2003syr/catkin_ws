<launch>
    <!-- Closed-loop evaluation of a BC policy in the same box-detour task
         used to collect fused_box_teacher_30ep.npz. -->
    <arg name="gui" default="true" />
    <arg name="paused" default="false" />
    <arg name="episodes" default="10" />
    <arg name="seed" default="100123" />
    <arg name="policy_host" default="127.0.0.1" />
    <arg name="policy_port" default="5563" />
    <arg name="evaluation_detour_side" default="0.0" />
    <arg name="minimum_success_rate" default="0.80" />
    <arg name="maximum_collisions" default="0" />
    <arg name="minimum_overlap_rate" default="0.10" />
    <arg name="maximum_safety_rate" default="0.20" />
    <arg name="enable_student_stall_takeover" default="true" />
    <arg name="student_base_stall_cycles" default="20" />
    <arg name="student_arm_finish_stall_cycles" default="20" />
    <arg name="max_steps" default="1200" />
    <arg name="obstacle_x_offset" default="0.0" />
    <arg name="obstacle_y_offset" default="0.0" />

    <include file="$(find mobile_arm_description)/launch/gazebo_planar_avoidance.launch">
        <arg name="gui" value="$(arg gui)" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="obstacle_x_offset" value="$(arg obstacle_x_offset)" />
        <arg name="obstacle_y_offset" value="$(arg obstacle_y_offset)" />
        <arg name="disable_arm_collisions" value="false" />
        <arg name="enable_arm_contacts" value="true" />
    </include>

    <node pkg="mobile_arm_rl_env"
          type="evaluate_fused_box_detour_bc.py"
          name="evaluate_fused_box_detour_bc"
          output="screen"
          required="true">
        <param name="episodes" value="$(arg episodes)" />
        <param name="seed" value="$(arg seed)" />
        <param name="policy_host" value="$(arg policy_host)" />
        <param name="policy_port" value="$(arg policy_port)" />
        <param name="policy_timeout" value="5.0" />
        <param name="evaluation_detour_side"
               value="$(arg evaluation_detour_side)" />
        <param name="minimum_success_rate"
               value="$(arg minimum_success_rate)" />
        <param name="maximum_collisions"
               value="$(arg maximum_collisions)" />
        <param name="minimum_overlap_rate" value="$(arg minimum_overlap_rate)" />
        <param name="maximum_safety_rate" value="$(arg maximum_safety_rate)" />
        <param name="max_steps" value="$(arg max_steps)" />
        <param name="enable_student_action_guard" value="true" />
        <param name="enable_student_stall_takeover"
               value="$(arg enable_student_stall_takeover)" />
        <param name="student_base_stall_cycles"
               value="$(arg student_base_stall_cycles)" />
        <param name="student_arm_finish_stall_cycles"
               value="$(arg student_arm_finish_stall_cycles)" />
        <param name="student_stall_minimum_progress" value="0.0001" />
        <param name="safety_delta_threshold" value="0.01" />
        <param name="log_interval" value="25" />

        <param name="enable_planar_base" value="true" />
        <param name="require_scan" value="true" />
        <param name="scan_topic" value="/scan" />
        <param name="contact_topic" value="/base_contacts" />
        <param name="arm_contact_topic" value="/arm_contacts" />
        <param name="target_frame" value="fused_box_detour_target_frame" />
        <param name="model_name" value="mobile_arm" />
        <rosparam param="reset_base_positions">[0.0, 0.0, 1.5708]</rosparam>
        <rosparam param="reset_arm_positions">
            [0.0, -0.30, 0.03, 0.0, 0.03, 0.0]
        </rosparam>
        <param name="target_min_z" value="0.10" />
        <param name="target_max_z" value="1.20" />
        <param name="target_min_chassis_clearance" value="0.015" />
        <param name="success_threshold" value="0.05" />
        <param name="reset_position_tolerance" value="0.02" />
        <param name="reset_velocity_tolerance" value="0.02" />
        <param name="reset_settle_window" value="0.50" />
        <param name="reset_drift_tolerance" value="0.002" />
        <param name="reset_attempts" value="3" />
        <param name="idle_hold_reset_service"
               value="/arm_idle_position_hold/reset_targets" />
        <param name="reset_timeout" value="7.0" />

        <rosparam param="box_center_xy">[0.85, -0.13]</rosparam>
        <rosparam param="box_size_xy">[0.20, 0.32]</rosparam>
        <rosparam param="final_base_goal_xy">[1.60, -0.13]</rosparam>
        <param name="base_half_length" value="0.56" />
        <param name="base_half_width" value="0.10" />
        <param name="path_clearance" value="0.15" />
        <param name="waypoint_tolerance" value="0.10" />
        <param name="final_base_position_tolerance" value="0.03" />
        <param name="final_base_yaw_tolerance" value="0.08" />
        <param name="terminal_pose_enter_position_tolerance" value="0.03" />
        <param name="terminal_pose_exit_position_tolerance" value="0.06" />
        <param name="terminal_pose_stable_cycles" value="3" />
        <param name="arm_finish_stall_cycles" value="20" />
        <param name="arm_finish_joint_reference_gain" value="0.35" />
        <param name="arm_box_release_margin" value="0.02" />
        <param name="detour_side" value="1.0" />
        <param name="box_collision_penalty" value="8.0" />
        <param name="box_timeout_penalty" value="1.0" />
        <param name="box_path_reward_scale" value="5.0" />
        <param name="box_ee_reward_scale" value="2.0" />
        <param name="box_yaw_reward_scale" value="2.0" />
        <param name="box_time_penalty" value="0.001" />
        <param name="box_success_bonus" value="20.0" />

        <param name="base_linear_action_scale" value="0.25" />
        <param name="base_yaw_action_scale" value="0.25" />
        <param name="teacher_base_gain" value="2.5" />
        <param name="teacher_yaw_gain" value="1.5" />
        <param name="teacher_arm_gain" value="1.0" />
        <param name="teacher_arm_start_distance" value="0.30" />
        <param name="teacher_base_stop_distance" value="0.04" />
        <param name="teacher_heading_slow_angle" value="0.70" />
        <param name="teacher_max_cartesian_speed" value="0.05" />
        <param name="teacher_dls_damping" value="0.03" />
    </node>
</launch>
