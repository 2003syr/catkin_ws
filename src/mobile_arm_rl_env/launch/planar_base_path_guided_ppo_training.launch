<launch>
    <!-- Preferred entry point for:
         rule-based high-level local pose subgoal (x, y, yaw)
         + local path preview
         + low-level PPO [v, omega]
         + emergency-only LiDAR shield. -->
    <arg name="gui" default="false" />
    <arg name="port" default="5558" />
    <arg name="seed" default="123" />

    <include file="$(find mobile_arm_rl_env)/launch/planar_base_direct_ppo_training.launch">
        <arg name="gui" value="$(arg gui)" />
        <arg name="port" value="$(arg port)" />
        <arg name="seed" value="$(arg seed)" />
    </include>
</launch>
